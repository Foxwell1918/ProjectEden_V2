		{"id":"269d052278894efc","type":"text","text":"12. Eddie took on the offer, and sails to Edenfield.","x":3120,"y":835,"width":250,"height":82},
		{"id":"7d045dbbeff72a65","x":2555,"y":60,"width":250,"height":89,"type":"text","text":"Catherine was the one who diverted the Paladin Units so she can get to Eddie."},
		{"id":"3529d7930ed9ba3e","x":2746,"y":122,"width":250,"height":60,"type":"text","text":"Why couldn't she just go to Eddie?"},
		{"id":"c8fc780f54edfc5e","x":2153,"y":593,"width":250,"height":87,"type":"text","text":"The Bully in Hospital was the one he accidentally injured"},
