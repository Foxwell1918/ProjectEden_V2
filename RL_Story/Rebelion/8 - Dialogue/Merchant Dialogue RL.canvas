		{"id":"ab5096324a33fee1","type":"text","text":"Character: Tries to lighten-up the mood during intense situation","x":-140,"y":812,"width":250,"height":115},
		{"id":"7cd413f054e386b6","type":"text","text":"Character: Determined, wanting to save her father and do the Impossible.","x":400,"y":812,"width":250,"height":96},
		{"id":"ef055d3c0438de1f","type":"text","text":"Character: Tries to speak, fighting his own tiredness to say his worry for Kenari","x":-691,"y":780,"width":250,"height":102},
