		{"id":"dabf0bb5aef5fcd3","x":6668,"y":-125,"width":58,"height":50,"color":"3","type":"text","text":"6"},
		{"id":"51df710fb0998ec1","type":"text","text":"I understand, but If you run out there with nothing but your stubborn will, your father will be mourning you too. We just have to be reasonable about this.","x":6442,"y":872,"width":942,"height":118,"color":"5"}
