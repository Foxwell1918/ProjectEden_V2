		{"id":"4a024d3429ce590b","type":"text","text":"4.  But she is vigilant, she see things.","x":4470,"y":-1464,"width":360,"height":59},
		{"id":"e3f06792e0838b86","type":"text","text":"5.  Karma said something to please ","x":4470,"y":-1389,"width":360,"height":60},
		{"id":"a5793a8ab11da337","type":"text","text":"6. she said something that eludes to her sending troops","x":4470,"y":-1318,"width":460,"height":72},
