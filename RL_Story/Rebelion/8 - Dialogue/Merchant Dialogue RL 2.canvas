		{"id":"c5fa4b09d54c605b","type":"text","text":"7. Aksara immediately goes","x":2210,"y":-473,"width":250,"height":60},
		{"id":"a8b57b052f6d98d4","type":"text","text":"Well done, friend! I knew you’d manage it!","x":2750,"y":-1148,"width":250,"height":60,"color":"5"},
		{"id":"6ce72845756242eb","type":"text","text":"You made it! The power’s really back, and thanks to you Dad’s pacemaker is going to work again!","x":2750,"y":-1088,"width":250,"height":131,"color":"3"},
		{"id":"d8f7ce79308da03f","type":"text","text":"I was so scared earlier, I didn’t mean to say those words... Thank you for everything.","x":2750,"y":-956,"width":250,"height":116,"color":"3"},
		{"id":"207c87491ca84a53","type":"text","text":"I’m glad I could help; that’s enough for me.","x":2750,"y":-840,"width":250,"height":80,"color":"4"},
		{"id":"754d32cbb043a058","type":"text","text":"You seems pretty uneasy, is something wrong?","x":2750,"y":-760,"width":250,"height":77,"color":"4"},
		{"id":"c12f5088b4ee6f68","type":"text","text":"Information needed that ","x":2376,"y":-160,"width":250,"height":60},
		{"id":"500260cb81944352","type":"text","text":"Aksara","x":2750,"y":-1263,"width":250,"height":59,"color":"4"},
