		{"id":"b88f416c0ebcc952","type":"text","text":"No, Aksara. It's too dangerous.","x":1620,"y":3543,"width":250,"height":63,"color":"5"},
		{"id":"3578fd6e5ee011b1","type":"text","text":"Maybe you are the Dawn... The Sun that will shine their light in the upcoming darkness.","x":2195,"y":3258,"width":250,"height":131,"color":"1"},
