		{"id":"6d6bae55650518cb","type":"text","text":"4.  She decided to follow him, since Garuda hadn't returned","x":1950,"y":2576,"width":250,"height":90},
		{"id":"b6b39a5c452aa432","type":"text","text":"Oh, I'm waiting for someone, it's pretty urgent. I have to go to that Fortress before they send troopers to destroy Sukawati!","x":2320,"y":2464,"width":250,"height":146,"color":"4"},
