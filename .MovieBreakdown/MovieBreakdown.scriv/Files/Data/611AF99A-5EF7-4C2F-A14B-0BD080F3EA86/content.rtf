\pard\plain \li720\ri-720\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 Soft music plays, The scene opens with a landscape of early morning, as the sun is peeping from two tall apartment building}
\par\plain {\f1\fs24 The camera then goes down, overlooking a quiet highway, on it there is an advertisement for SIGMUND CORP}
\par\plain {\f1\fs24 A black SEDAN car passes along, and the camera cuts}
\par\pard\plain \li6480\ri-173\sb240\sl-240\slmult0\qr\ltrch\loch {\f1\fs24 FADE OUT.}
\par\pard\plain \li720\ri-720\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 The same car passes a neighbourhood, the locals are walking about}
\par\pard\plain \li6480\ri-173\sb240\sl-240\slmult0\qr\ltrch\loch {\f1\fs24 FADE OUT.}
\par\pard\plain \li720\ri-720\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 The car is now on a quiet forested area, it is driving smoothly}
\par\plain {\f1\fs24 And then, a squirrel pops out of nowhere from the bush.}
\par\plain {\f1\fs24 The black sedan swirved, screeched, it almost merged to the left lane hitting a truck carrying flammable materials.}
\par\plain {\f1\fs24 And then the car hovers smoothly again.}
\par\pard\plain \li720\ri-720\sb480\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 <$ScrKeepWithNext>INT. CAR - DAY}
\par\pard\plain \li720\ri-720\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 DR NEIL WATTS, who is clutching the overhead handle and putting his knee on the dashboard in front of him in panic, looks over to DR EVA ROSALENE and the road over and over again}
\par\pard\plain \li3600\ri-360\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 <$ScrKeepWithNext>DR. NEIL WATTS}
\par\pard\plain \li2160\ri1440\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 What the fuck EVA?!}
\par\pard\plain \li3600\ri-360\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 <$ScrKeepWithNext>DR. EVA ROSALENE}
\par\pard\plain \li2160\ri1440\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 That, how you keep everyone alive, including the squirrel. Hope you learned something.}
\par\pard\plain \li3600\ri-360\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 <$ScrKeepWithNext>DR. NEIL WATTS}
\par\pard\plain \li2160\ri1440\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 Look, sometimes, it's either us or them.}
\par\pard\plain \li2880\ri2160\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 (straightening himself up)}
\par\pard\plain \li2160\ri1440\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 By keeping ourselves alive now, we can be around to stop more self-inflicted critter casualties later.}
\par\pard\plain \li2880\ri2160\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 (putting his finger on his temple)}
\par\pard\plain \li2160\ri1440\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 Logic}
\par\pard\plain \li3600\ri-360\sb240\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 <$ScrKeepWithNext>DR. EVA ROSALENE}
\par\pard\plain \li2160\ri1440\sl-240\slmult0\ql\ltrch\loch {\f1\fs24 Enlightening.}}